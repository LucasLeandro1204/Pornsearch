    "watch": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --fix src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "node ./example/example.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "porn",
    "nsfw",
    "pornhub",
    "xvideos",
    "sex",
    "videos",
    "video",
    "redtube",
    "boobs",
    "gifs",
    "gif"
  ],
  "repository": {
