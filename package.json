  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^25.2.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "path": "^0.12.7",
    "prettier": "^3.8.1",
